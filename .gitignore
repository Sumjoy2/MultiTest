# Ignore log files
*.log

# Visual Studio 2015 user specific files
.vs/
*.vsconfig

# Visual Studios code user specific files
.vscode/

# Rider user specific files
.idea/
**.sln.DotSettings.user

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.code-workspace
*.sln
*.suo
*.opensdf
*.opendb
*.sdf
*.VC.db
*.VC.opendb
*.vsconfig

# Binary Files
Binaries/*
Binaries/*/Win64/*
Plugins/*/Binaries/*

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*
Plugins/Developer/*

# Cache files for the editor to use
DerivedDataCache/*

# Plugin related .git ignore and git attributes files
Plugins/*/.gitignore
Plugins/*/.gitattributes

# Dont ignore certain binaries
!Binaries/Win64/*Editor.target
!Binaries/Win64/UnrealEditor.modules
!Binaries/Win64/UnrealEditor-Home.dll

# Don't ignore icon files in Build
!Build/**/*.ico
!Build/**/*.png

# Ignore IDE things

.idea/*
.idea/**
.vscode/*
.vscode/**

# Ignore linux stuff
**/Linux/*
**/Linux/**
MakeFile
Makefile
.ignore

# Whitelist UATerry
!uaterry.exe
